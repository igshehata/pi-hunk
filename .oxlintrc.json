{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "maxWarnings": 0
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["dist/**", "coverage/**", ".pi-subagents/**"]
}
